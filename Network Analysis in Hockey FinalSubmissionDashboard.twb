      <column caption='Players In Sequence ' datatype='integer' name='[Calculation_1856046056452104193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Sequence ID] : MAX(IF [Player] = [Parameters].[Detail 1 Parameter] THEN 1 ELSE 0 END) }' />
      </column>
      <column caption='Team Adjusted ' datatype='string' name='[Calculation_2096144212643450880]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Team], &quot;Women -&quot;) THEN&#13;&#10;    MID([Team], FIND([Team], &quot;-&quot;) + 2, LEN([Team]) - FIND([Team], &quot;-&quot;) - 1)&#13;&#10;ELSE&#13;&#10;    [Team]&#13;&#10;END' />
      </column>
